GROQ_API_KEY=# La clave esta en el .env
GROQ_MODEL=openai/gpt-oss-120b
# Alternativa: GROQ_MODEL=llama-3.3-70b-versatile

LLM_TEMPERATURE=0
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
